<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Allows building and testing the platform-independent parts on Linux/macOS CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>1.0.0</Version>
    <Product>SnapBack</Product>
    <Company>SnapBack contributors</Company>
    <Authors>SnapBack contributors</Authors>
    <Copyright>Copyright (c) SnapBack contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
