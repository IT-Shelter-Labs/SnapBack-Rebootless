<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:SnapBack.App.Localization">

    <Style x:Key="AppListItem" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
    </Style>

    <!-- Column header: each title is a button that sorts by that column (click again to reverse). -->
    <Style x:Key="SortHeaderButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="AppRowTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" VerticalAlignment="Center" MinWidth="0"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.Name="{Binding Name}" />
            <TextBlock Grid.Column="0" Style="{StaticResource Icon}" Text="&#xE72E;" Opacity="0.6" HorizontalAlignment="Center"
                       Visibility="{Binding IsSelectable, Converter={StaticResource InverseBoolToVisibility}}" />

            <Image Grid.Column="1" Width="28" Height="28" Source="{Binding Icon}" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
            </StackPanel>

            <TextBlock Grid.Column="3" Text="{Binding MemoryText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" />
            <TextBlock Grid.Column="4" Text="{Binding ProcessCount}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,28,0" Style="{StaticResource Secondary}" />

            <Border Grid.Column="5" Style="{StaticResource Badge}">
                <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BadgeText}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
            </Border>
        </Grid>
    </DataTemplate>

    <!-- DataContext: MainViewModel. -->
    <DataTemplate x:Key="AppListHeader">
        <Grid Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" Style="{StaticResource SortHeaderButton}" HorizontalAlignment="Left"
                    Content="{Binding NameHeader}" Command="{Binding SortCommand}" CommandParameter="Name"
                    AutomationProperties.AutomationId="SortName" ToolTip="{l:Tr Sort_Tooltip}" />
            <Button Grid.Column="3" Style="{StaticResource SortHeaderButton}" HorizontalAlignment="Right" Margin="0,0,16,0"
                    Content="{Binding MemoryHeader}" Command="{Binding SortCommand}" CommandParameter="Memory"
                    AutomationProperties.AutomationId="SortMemory" ToolTip="{l:Tr Sort_Tooltip}" />
            <Button Grid.Column="4" Style="{StaticResource SortHeaderButton}" HorizontalAlignment="Right" Margin="0,0,24,0"
                    Content="{Binding ProcessesHeader}" Command="{Binding SortCommand}" CommandParameter="Processes"
                    AutomationProperties.AutomationId="SortProcesses" ToolTip="{l:Tr Sort_Tooltip}" />
            <Button Grid.Column="5" Style="{StaticResource SortHeaderButton}" HorizontalAlignment="Left"
                    Content="{Binding RiskHeader}" Command="{Binding SortCommand}" CommandParameter="Risk"
                    AutomationProperties.AutomationId="SortRisk" ToolTip="{l:Tr Sort_Tooltip}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
