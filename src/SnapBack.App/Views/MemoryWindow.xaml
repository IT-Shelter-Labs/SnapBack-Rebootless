<Window x:Class="SnapBack.App.Views.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SnapBack.App.ViewModels"
        xmlns:l="clr-namespace:SnapBack.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MemoryViewModel}"
        Title="{l:Tr Memory_WindowTitle}" FontFamily="{Binding UiFont, Source={x:Static l:Tr.Instance}}"
        Width="760" Height="800" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="MemoryWindow">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{l:Tr Memory_Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

                <!-- Current memory -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="MemoryRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Plain-language advice -->
                <Border Style="{StaticResource InfoBar}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding AdviceTitle}" FontWeight="SemiBold" AutomationProperties.AutomationId="AdviceTitle" />
                        <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Memory growth over time (from the background history; never called a leak) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Growth_Title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr Growth_Explain}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding GrowthEmptyText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None"
                                   Visibility="{Binding HasGrowth, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Growth}" AutomationProperties.AutomationId="GrowthList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LevelText}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary}" />
                                        <TextBlock Text="{Binding Timeline}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Optional Deep Memory Cleanup -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Memory_DeepTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr Memory_DeepWhat}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{l:Tr Memory_DeepNot}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6" />
                        <TextBlock Text="{l:Tr Memory_DeepCost}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10" />

                        <RadioButton GroupName="Mode" IsChecked="{Binding ModeStandby}" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Deep_Mode_Standby}" FontWeight="SemiBold" />
                                <TextBlock Text="{l:Tr Memory_ModeStandbyHint}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Mode" IsChecked="{Binding ModeLowPriority}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Deep_Mode_LowPriorityStandby}" FontWeight="SemiBold" />
                                <TextBlock Text="{l:Tr Memory_ModeLowHint}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="{Binding ElevationNote}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" />
                        <Button Command="{Binding RunCleanupCommand}" HorizontalAlignment="Left" Padding="14,8" AutomationProperties.AutomationId="RunDeepCleanupButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,6,0" />
                                <TextBlock Text="{l:Tr Memory_Run}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                   Visibility="{Binding Status, Converter={StaticResource HasValueToVisibility}}" />

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ResultText, Converter={StaticResource HasValueToVisibility}}">
                            <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="DeepCleanupResult" />
                            <ItemsControl ItemsSource="{Binding ResultRows}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding BeforeText}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" Style="{StaticResource Secondary}" />
                                            <TextBlock Grid.Column="3" Text="{Binding AfterText}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="{Binding DeltaText}" Style="{StaticResource Secondary}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:Tr Memory_ResultExplain}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button Content="{l:Tr Main_Refresh}" Command="{Binding RefreshCommand}" Padding="14,8" />
            <Button Content="{l:Tr Common_Close}" IsCancel="True" HorizontalAlignment="Right" Padding="22,8" Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
