<Window x:Class="SnapBack.App.Views.OperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SnapBack.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OperationViewModel}"
        Title="Returning to baseline — SnapBack" Width="820" Height="620" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" Style="{StaticResource Secondary}" FontSize="14" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="{Binding Header}" FontSize="22" FontWeight="SemiBold" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Rows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" />
                        <Image Grid.Column="1" Source="{Binding Icon}" Width="24" Height="24" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Margin="4,0,12,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None"
                                       Visibility="{Binding DetailText, Converter={StaticResource HasValueToVisibility}}" />
                        </StackPanel>
                        <CheckBox Grid.Column="3" Content="Force-terminate" VerticalAlignment="Center"
                                  IsChecked="{Binding ForceSelected, Mode=TwoWay}"
                                  Visibility="{Binding CanForce, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,12,0,12"
                   Visibility="{Binding Summary, Converter={StaticResource HasValueToVisibility}}" />

        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Left" Content="Stop waiting" Command="{Binding StopCommand}" Padding="14,8"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Stop waiting for apps to close. Nothing is forced." />
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Visibility="{Binding HasStillRunning, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Check again" Command="{Binding RecheckCommand}" Padding="14,8" Margin="0,0,8,0"
                        ToolTip="If you answered an app's save prompt, check whether it has closed now" />
                <Button Command="{Binding ForceCommand}" Style="{StaticResource DangerButton}" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,6,0" />
                        <TextBlock Text="Force-terminate selected…" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button Content="Close" HorizontalAlignment="Right" Padding="22,8" Click="Close_Click"
                    IsEnabled="{Binding IsFinished}" Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
