<Window x:Class="SnapBack.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SnapBack.App.Localization"
        FontFamily="{Binding UiFont, Source={x:Static l:Tr.Instance}}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="PromptWindow">
    <StackPanel Margin="24,16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <ComboBox x:Name="ValueBox" IsEditable="True" IsTextSearchEnabled="False" AutomationProperties.AutomationId="PromptValue" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:Tr Common_Cancel}" IsCancel="True" Padding="18,8" Margin="0,0,8,0" />
            <Button Content="{l:Tr Common_OK}" IsDefault="True" Click="Ok_Click" Style="{DynamicResource AccentButtonStyle}" Padding="22,8"
                    AutomationProperties.AutomationId="PromptOk" />
        </StackPanel>
    </StackPanel>
</Window>
