<Window x:Class="SnapBack.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SnapBack.App.ViewModels"
        xmlns:l="clr-namespace:SnapBack.App.Localization"
        xmlns:s="clr-namespace:SnapBack.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{l:Tr Settings_WindowTitle}" FontFamily="{Binding UiFont, Source={x:Static l:Tr.Instance}}"
        Width="720" Height="820" MinWidth="540" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="SettingsWindow">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{l:Tr Settings_Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="IT Shelter" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr Contact_Description}" Style="{StaticResource Secondary}"
                                   TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap">
                            <Hyperlink NavigateUri="{x:Static s:CommunityLinks.Telegram}" RequestNavigate="Contact_RequestNavigate"
                                       ToolTip="{l:Tr Contact_TelegramHint}" AutomationProperties.AutomationId="SettingsTelegramLink">
                                <Run Text="{l:Tr Contact_Telegram}" />
                            </Hyperlink>
                            <Run Text="  ·  " />
                            <Hyperlink NavigateUri="{x:Static s:CommunityLinks.GitHub}" RequestNavigate="Contact_RequestNavigate"
                                       ToolTip="{l:Tr Contact_GitHubHint}" AutomationProperties.AutomationId="SettingsGitHubLink">
                                <Run Text="{l:Tr Contact_GitHub}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_Language}" Style="{StaticResource SectionTitle}" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" DisplayMemberPath="Name"
                                  HorizontalAlignment="Left" MinWidth="260" AutomationProperties.AutomationId="LanguageCombo"
                                  AutomationProperties.Name="{l:Tr Settings_Language}" />
                        <TextBlock Text="{l:Tr Settings_LanguageHint}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_Closing}" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding GracefulTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{l:Tr Settings_Timeout}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <CheckBox IsChecked="{Binding PreselectCautionItems}">
                            <TextBlock Text="{l:Tr Settings_PreselectCaution}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" Text="{l:Tr Settings_ClosingHint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_Startup}" Style="{StaticResource SectionTitle}" />
                        <CheckBox IsChecked="{Binding StartWithWindows}" AutomationProperties.AutomationId="StartWithWindowsCheck">
                            <TextBlock Text="{l:Tr Settings_StartWithWindows}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{Binding StartupDisabledNote}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="28,2,0,0"
                                   Visibility="{Binding StartupDisabledNote, Converter={StaticResource HasValueToVisibility}}" />
                        <StackPanel Margin="28,4,0,0" IsEnabled="{Binding StartWithWindows}">
                            <CheckBox IsChecked="{Binding StartMinimizedToTray}" AutomationProperties.AutomationId="StartMinimizedCheck">
                                <TextBlock Text="{l:Tr Settings_StartMinimized}" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding AutoBaselineOnSignIn}" AutomationProperties.AutomationId="AutoBaselineCheck">
                                <TextBlock Text="{l:Tr Settings_AutoBaselineEnable}" TextWrapping="Wrap" />
                            </CheckBox>
                            <StackPanel Margin="28,4,0,0" IsEnabled="{Binding AutoBaselineOnSignIn}">
                                <DockPanel Margin="0,0,0,6" Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox DockPanel.Dock="Right" MinWidth="180" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding AutoBaselineProfile}"
                                              DisplayMemberPath="DisplayName" AutomationProperties.Name="{l:Tr Settings_AutoBaselineProfile}" />
                                    <TextBlock Text="{l:Tr Settings_AutoBaselineProfile}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding AutoBaselineMinDelaySeconds, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="{l:Tr Settings_MinDelay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding AutoBaselineQuietSeconds, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="{l:Tr Settings_Quiet}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" Text="{l:Tr Settings_StartupHint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_Tray}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr Settings_CloseButton}" Margin="0,0,0,4" />
                        <RadioButton GroupName="CloseButton" IsChecked="{Binding CloseToTray}" Margin="0,0,0,2" AutomationProperties.AutomationId="CloseToTrayRadio">
                            <TextBlock Text="{l:Tr Settings_CloseToTray}" TextWrapping="Wrap" />
                        </RadioButton>
                        <RadioButton GroupName="CloseButton" IsChecked="{Binding ExitOnClose}" AutomationProperties.AutomationId="ExitOnCloseRadio">
                            <TextBlock Text="{l:Tr Settings_ExitOnClose}" TextWrapping="Wrap" />
                        </RadioButton>
                        <CheckBox IsChecked="{Binding ShowNotifications}" Margin="0,10,0,0" AutomationProperties.AutomationId="NotificationsCheck">
                            <TextBlock Text="{l:Tr Settings_Notifications}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="28,2,0,0" Text="{l:Tr Settings_NotificationsHint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_Rules}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" Text="{l:Tr Settings_RulesHint}" />
                        <TextBlock Text="{l:Tr Settings_RulesEmpty}" Style="{StaticResource Secondary}"
                                   Visibility="{Binding Rules.Count, Converter={StaticResource NoValueToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Content="{l:Tr Common_Remove}" Padding="10,2" Margin="8,0,0,0"
                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <ComboBox DockPanel.Dock="Right" MinWidth="170" ItemsSource="{Binding Options}" SelectedItem="{Binding Kind}" DisplayMemberPath="Name"
                                                  AutomationProperties.Name="{Binding DisplayName}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AppKey}" Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_Data}" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding HistoryLimit, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{l:Tr Settings_HistoryLimit}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{l:Tr Settings_DataFolder}" Style="{StaticResource Secondary}" />
                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Tr Settings_OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" Padding="12,6" Margin="0,0,8,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Tr Common_Cancel}" IsCancel="True" Padding="18,8" Margin="0,0,8,0" />
            <Button Content="{l:Tr Common_Save}" Click="Save_Click" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Padding="22,8"
                    AutomationProperties.AutomationId="SaveSettingsButton" />
        </StackPanel>
    </Grid>
</Window>
