<Window x:Class="SnapBack.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SnapBack.App.ViewModels"
        xmlns:l="clr-namespace:SnapBack.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{l:Tr Settings_WindowTitle}" FontFamily="{Binding UiFont, Source={x:Static l:Tr.Instance}}"
        Width="700" Height="760" MinWidth="540" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="SettingsWindow">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{l:Tr Settings_Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_Language}" Style="{StaticResource SectionTitle}" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" DisplayMemberPath="Name"
                                  HorizontalAlignment="Left" MinWidth="260" AutomationProperties.AutomationId="LanguageCombo"
                                  AutomationProperties.Name="{l:Tr Settings_Language}" />
                        <TextBlock Text="{l:Tr Settings_LanguageHint}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_Closing}" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding GracefulTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{l:Tr Settings_Timeout}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <CheckBox IsChecked="{Binding PreselectCautionItems}">
                            <TextBlock Text="{l:Tr Settings_PreselectCaution}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" Text="{l:Tr Settings_ClosingHint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_AutoBaseline}" Style="{StaticResource SectionTitle}" />
                        <CheckBox IsChecked="{Binding AutoBaselineOnSignIn}">
                            <TextBlock Text="{l:Tr Settings_AutoBaselineEnable}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,8" Text="{l:Tr Settings_AutoBaselineHint}" />
                        <DockPanel Margin="0,0,0,6" IsEnabled="{Binding AutoBaselineOnSignIn}">
                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding AutoBaselineMinDelaySeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{l:Tr Settings_MinDelay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel IsEnabled="{Binding AutoBaselineOnSignIn}">
                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding AutoBaselineQuietSeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{l:Tr Settings_Quiet}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_KeepList}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" Text="{l:Tr Settings_KeepListHint}" />
                        <TextBlock Text="{l:Tr Settings_KeepListEmpty}" Style="{StaticResource Secondary}"
                                   Visibility="{Binding KeepList.Count, Converter={StaticResource NoValueToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding KeepList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="{l:Tr Common_Remove}" Padding="10,2"
                                                Command="{Binding DataContext.RemoveKeepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AppKey}" Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Settings_Data}" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding HistoryLimit, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{l:Tr Settings_HistoryLimit}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{l:Tr Settings_DataFolder}" Style="{StaticResource Secondary}" />
                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Tr Settings_OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" Padding="12,6" Margin="0,0,8,0" />
                            <Button Content="{l:Tr Settings_DeleteBaseline}" Command="{Binding DeleteBaselineCommand}" Padding="12,6" Style="{StaticResource DangerButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Tr Common_Cancel}" IsCancel="True" Padding="18,8" Margin="0,0,8,0" />
            <Button Content="{l:Tr Common_Save}" Click="Save_Click" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Padding="22,8"
                    AutomationProperties.AutomationId="SaveSettingsButton" />
        </StackPanel>
    </Grid>
</Window>
